{
  "name": "@al-lsp-for-agents/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "tsx scripts/fetch-vsix.ts",
    "refresh": "tsx scripts/refresh-lock.ts",
    "test:unit": "node --import tsx ./node_modules/mocha/bin/mocha.js 'unit/**/*.test.ts'",
    "build": "tsc && tsc -p tsconfig.suite.json && tsx scripts/post-build.ts",
    "test:cell": "npm run build && tsx runOneCell.ts",
    "test:matrix": "npm run build && tsx runMatrix.ts"
  },
  "devDependencies": {
    "@types/mocha": "10.0.7",
    "@types/node": "20.14.10",
    "@types/vscode": "1.94.0",
    "@vscode/test-electron": "2.4.1",
    "glob": "10.4.5",
    "mocha": "10.7.3",
    "tsx": "4.19.0",
    "typescript": "5.6.2"
  }
}
